# Copy to .env for local runs (or set these in Render → Environment).
# Postgres URL from Render. Leave unset locally to use a SQLite file (lms.db).
DATABASE_URL=
# Long random string. Render generates one automatically from render.yaml.
SECRET_KEY=change-me
# Comma-separated 10-digit mobile numbers that get the admin dashboard.
ADMIN_PHONES=9876543210
# Optional. If set, companions need this code to register.
REGISTRATION_CODE=PEAKAGE2026
# true on Render (HTTPS); false for local http://localhost.
HTTPS_ONLY=false
